rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // ── 기본 정책: 모두 거부 (명시적으로 허용된 것만 가능) ──
    match /{allPaths=**} {
      allow read: if false;
      allow write: if false;
    }

    // ── 앨범 사진 (공개 읽기, 검증된 이미지만 쓰기) ──
    // 앱에 Firebase Auth가 없으므로 로그인 요구 대신 파일 검증으로 제한한다.
    // (관리자 확인은 앱 내 비밀번호 방식으로 이루어짐)
    match /albums/{albumId}/{fileName} {
      // 읽기: 모든 사용자 (갤러리 공개)
      allow read: if true;

      // 업로드/수정: 파일 타입·크기·이름 검증
      allow create, update: if isValidImage()
        && isValidSize()
        && fileName.matches('.*\\.jpg');

      // 삭제: 앨범 경로 내 파일만 (삭제 요청에는 request.resource가 없음)
      allow delete: if true;
    }

    // ── 헬퍼 함수들 ──
    function isValidImage() {
      // 허용 파일 타입: JPG, PNG, WEBP
      let contentType = request.resource.contentType;
      return contentType != null && (
        contentType.matches('image/jpeg') ||
        contentType.matches('image/png') ||
        contentType.matches('image/webp')
      );
    }

    function isValidSize() {
      // 파일 크기 제한: 최대 10MB (로컬 압축되므로 충분함)
      return request.resource.size <= 10 * 1024 * 1024;
    }
  }
}
